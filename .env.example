# NinjaOne API Configuration
# Copy this file to .env and fill in your credentials

# OAuth2 Client ID from NinjaOne API settings
NINJAONE_CLIENT_ID=your_client_id_here

# OAuth2 Client Secret from NinjaOne API settings
NINJAONE_CLIENT_SECRET=your_client_secret_here

# NinjaOne Instance URL (without https://)
# Examples: app.ninjarmm.com, eu.ninjarmm.com, ca.ninjarmm.com, oc.ninjarmm.com
NINJAONE_INSTANCE=app.ninjarmm.com

# OAuth2 Scope (optional, defaults to 'monitoring')
NINJAONE_SCOPE=monitoring
